{
  "expectation_suite_name": "openfda_l1_data_quality",
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18",
    "notes": "openFDA FAERS adverse-event fact \u2014 fail-closed L1 gates. Validates the real 300-report fact, not synthetic patient data."
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 1,
        "max_value": 100000
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "safetyreportid"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "safetyreportid"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "primary_drug"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "received_date"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "is_serious",
        "value_set": [
          true,
          false,
          "true",
          "false",
          "1",
          "0"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "n_drugs",
        "min_value": 0,
        "max_value": 50
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "n_reactions",
        "min_value": 0,
        "max_value": 200
      }
    }
  ]
}